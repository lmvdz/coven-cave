{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-pulse",
  "description": "lets the trusted loopback Pulse webview emit dismiss and open-Cave intents while the Rust shell owns its window lifecycle",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "webviews": [
    "pulse"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "permissions": [
    "core:event:allow-emit"
  ]
}
